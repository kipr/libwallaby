{
  "name": "libwallaby Dev",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "target": "dev"
  },
  "mounts": [
    "source=claude-config,target=/home/code/.claude,type=volume",
    "source=codex-config,target=/home/code/.codex,type=volume"
  ],
  // For the agent CLIs' bubblewrap sandbox: seccomp=unconfined because it
  // fails under Docker's default seccomp profile, systempaths=unconfined
  // because it can't mount /proc while Docker masks paths under it.
  "runArgs": [
    "--security-opt=seccomp=unconfined",
    "--security-opt=systempaths=unconfined"
  ],
  "remoteUser": "code",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools-extension-pack",
        "github.vscode-pull-request-github",
        "openai.chatgpt"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "fish",
        "terminal.integrated.profiles.linux": {
          "fish": { "path": "/usr/bin/fish" }
        }
      }
    }
  }
}
